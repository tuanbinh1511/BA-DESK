{
  "name": "ba-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "BA_DESK_AI_DISABLED=1 .venv/bin/python -m unittest discover -s server -p 'test_*.py'",
    "start": ".venv/bin/python -m uvicorn server.app:app --host 127.0.0.1 --port 8000",
    "start:remote": "sh scripts/start-remote.sh",
    "dev:ui:remote": "vite --host 127.0.0.1 --mode remote",
    "build:remote": "tsc -b && vite build --mode remote",
    "test:connection": "node scripts/test-connection.mjs"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.15.0",
    "motion": "^14.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
